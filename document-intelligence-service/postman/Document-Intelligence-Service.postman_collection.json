						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status is 200 OK', function() {",
									"    pm.response.to.have.status(200);",
									"    var data = pm.response.json();",
									"    if (data.items && data.items.length > 0) {",
									"        pm.collectionVariables.set('question_id', data.items[0].id);",
