# Application Settings
APP_NAME=document-intelligence-service
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database Configuration (PostgreSQL via psycopg3)
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/document_intelligence

# Redis & Celery Configuration
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_WORKER_CONCURRENCY=2
CELERY_TASK_MAX_RETRIES=3

# Security & CORS (comma-separated or JSON list)
ALLOWED_ORIGINS=["http://localhost:3000"]

# Logging & Operational Controls
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR=/app/storage/uploads

# Authentication & Security
JWT_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Document Ingestion & OCR Processing (Phase 5)
TESSERACT_CMD=tesseract
OCR_DPI=250
MIN_NATIVE_TEXT_CHARS=20
OCR_LANGUAGE=eng

# Confidence Engine & Human Review Configuration (Phase 8)
CONFIDENCE_OCR_WEIGHT=0.20
CONFIDENCE_TEXT_WEIGHT=0.20
CONFIDENCE_BOUNDARY_WEIGHT=0.15
CONFIDENCE_NUMBER_WEIGHT=0.10
CONFIDENCE_OPTIONS_WEIGHT=0.10
CONFIDENCE_SOURCE_WEIGHT=0.10
CONFIDENCE_PAGE_WEIGHT=0.05
CONFIDENCE_ANSWER_WEIGHT=0.10
CONFIDENCE_THRESHOLD_EXTRACTED=0.85
CONFIDENCE_THRESHOLD_PARTIAL=0.60

